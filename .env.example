# Settings the app needs. On Replit, add each one in the Secrets panel (padlock icon).
# Locally, copy this file to .env.local. Never commit real values.

# The database. Replit fills this in by itself when you add a database.
DATABASE_URL=

# Google sign-in: from the JSON file downloaded from Google Cloud (client_id and client_secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string that keeps sign-ins secure. Make one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The app's web address, e.g. https://batt-job-hub.replit.app
NEXTAUTH_URL=

# Only Google accounts on this domain can sign in
ALLOWED_EMAIL_DOMAIN=battelectrical.com

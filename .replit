run = "npm run dev -- -H 0.0.0.0 -p 3000"
modules = ["nodejs-22", "postgresql-16"]

[deployment]
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run migrate && npm run start"]
deploymentTarget = "autoscale"

[userenv]

[userenv.production]
NEXTAUTH_URL = "https://batt-job-hub.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js app"

[[workflows.workflow]]
name = "Next.js app"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -H 0.0.0.0 -p 3000"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80
